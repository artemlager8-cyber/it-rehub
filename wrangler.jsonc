// Cloudflare Workers deploy: the site is a static export, so the Worker only serves files from out/.
// Workers Builds settings: Build command `npm run build`, Deploy command `npx wrangler deploy`.
{
  "name": "it-rehub1",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    // Unknown URLs get out/404.html with a 404 status
    "not_found_handling": "404-page",
    // /ru/ serves out/ru/index.html, /ru redirects to /ru/
    "html_handling": "auto-trailing-slash"
  }
}
